{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juliangdeveloper.github.io/manga-engine/schema/manga.schema.json",
  "title": "Manga Engine page",
  "description": "Una página manga en blanco y negro: cuadrícula de columnas, filas en píxeles y viñetas con imagen y bocadillos. Todo el texto va en el JSON, nunca dentro de las imágenes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "rows",
    "panels"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 320,
      "maximum": 4000,
      "description": "Ancho de la página en píxeles. Por defecto 1080."
    },
    "padding": {
      "type": "number",
      "minimum": 0,
      "description": "Margen exterior en píxeles. Por defecto 28."
    },
    "gap": {
      "type": "number",
      "minimum": 0,
      "description": "Espacio entre viñetas en píxeles. Por defecto 16."
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24,
      "description": "Columnas de la cuadrícula. Por defecto 12."
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "description": "Alto de cada fila de la cuadrícula en píxeles, de arriba abajo."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Título grande de la cabecera."
        },
        "sub": {
          "$ref": "#/$defs/text",
          "description": "Subtítulo junto al título."
        }
      }
    },
    "footer": {
      "$ref": "#/$defs/text",
      "description": "Texto al pie de la página, por ejemplo — FIN —."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Título del libro en ePub y CBZ."
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$",
          "description": "Idioma BCP 47, por ejemplo es o en."
        },
        "creator": {
          "type": "string",
          "description": "Autor del libro."
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "description": "Portada del ePub y CBZ. Sin img usa la primera viñeta con imagen.",
      "properties": {
        "img": {
          "$ref": "#/$defs/image"
        },
        "focus": {
          "$ref": "#/$defs/focus"
        },
        "titleSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sub": {
          "$ref": "#/$defs/text"
        },
        "subSize": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "ereader": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ajustes de las páginas para e-reader.",
      "properties": {
        "rotate": {
          "$ref": "#/$defs/rotate"
        },
        "rotateDir": {
          "enum": [
            "cw",
            "ccw"
          ],
          "description": "Sentido del giro de las viñetas anchas."
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "description": "Margen en píxeles de cada página. Por defecto 6."
        },
        "gamma": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Gamma de los grises. Por defecto 1.1."
        },
        "sharpen": {
          "type": "number",
          "minimum": 0,
          "description": "Enfoque en porcentaje. Por defecto 70."
        },
        "cutoff": {
          "type": "number",
          "minimum": 0,
          "maximum": 49,
          "description": "Recorte del autocontraste en porcentaje. Por defecto 0.5."
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 95,
          "description": "Calidad JPEG. Por defecto la del perfil."
        }
      }
    },
    "strip": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ajustes del modo página completa cortada en pantallas.",
      "properties": {
        "title": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "pattern": "^[^/\\\\]+$",
          "description": "Nombre del archivo sin extensión."
        },
        "minFill": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Parte mínima de la pantalla que se llena antes de cortar. Por defecto 0.5."
        },
        "overlap": {
          "type": "number",
          "minimum": 0,
          "description": "Píxeles repetidos cuando el corte cae dentro de una viñeta. Por defecto 40."
        },
        "whiteMin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Gris mínimo de una línea para contarla como canal blanco. Por defecto 235."
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/panel"
      },
      "description": "Viñetas en orden de lectura."
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "description": "Texto; \\n hace salto de línea y <b>…</b> lo resalta."
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "description": "Ruta relativa al JSON o URL. La imagen no lleva texto."
    },
    "focus": {
      "type": "string",
      "description": "object-position de CSS, por ejemplo center 30%."
    },
    "rotate": {
      "anyOf": [
        {
          "const": "auto"
        },
        {
          "type": "boolean"
        }
      ],
      "description": "auto gira las viñetas anchas si así se leen más grandes; true o false lo fuerzan."
    },
    "span": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "[inicio, cuántas] empezando en 1."
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "col",
        "row"
      ],
      "properties": {
        "img": {
          "$ref": "#/$defs/image"
        },
        "col": {
          "$ref": "#/$defs/span",
          "minItems": 2,
          "description": "[columna inicial, columnas que ocupa]."
        },
        "row": {
          "$ref": "#/$defs/span",
          "description": "[fila inicial, filas que ocupa]; si falta la segunda, ocupa 1."
        },
        "focus": {
          "$ref": "#/$defs/focus"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Zoom de la imagen dentro de la viñeta."
        },
        "bw": {
          "type": "boolean",
          "description": "Imagen en grises. Por defecto true."
        },
        "tone": {
          "type": "boolean",
          "description": "Trama de puntos sobre la imagen. Por defecto true."
        },
        "border": {
          "type": "number",
          "minimum": 0,
          "description": "Grosor del borde en píxeles. Por defecto 6."
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "const": false
            }
          ],
          "description": "Número de la esquina; false lo oculta. Por defecto el orden."
        },
        "box": {
          "type": "string",
          "description": "Caja de texto bajo la imagen (HTML: <b>, <span class=\"t\">, <ul><li>, <div class=\"cols\">)."
        },
        "boxSize": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Tamaño de letra de la caja. Por defecto 31."
        },
        "ereader": {
          "type": "object",
          "additionalProperties": false,
          "description": "Ajustes de esta viñeta en el modo una viñeta por página.",
          "properties": {
            "fs": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Escala del texto de los bocadillos."
            },
            "boxFs": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Escala del texto de la caja."
            },
            "rotate": {
              "$ref": "#/$defs/rotate"
            },
            "bubbles": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^[0-9]+$": {
                  "$ref": "#/$defs/bubblePatch"
                }
              },
              "description": "Cambios por índice de bocadillo, por ejemplo {\"0\": {\"x\": 5}}."
            }
          }
        },
        "bubbles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bubble"
          }
        }
      }
    },
    "bubble": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "x",
        "y"
      ],
      "properties": {
        "type": {
          "enum": [
            "speech",
            "thought",
            "caption",
            "label",
            "sfx"
          ],
          "description": "speech diálogo, thought pensamiento, caption narración, label rótulo, sfx onomatopeya."
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "x": {
          "type": "number",
          "minimum": -50,
          "maximum": 150,
          "description": "Borde izquierdo en % del ancho de la viñeta."
        },
        "y": {
          "type": "number",
          "minimum": -50,
          "maximum": 150,
          "description": "Borde superior en % del alto de la viñeta."
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Ancho en píxeles."
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Tamaño de letra en píxeles."
        },
        "rot": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "Giro en grados."
        },
        "tail": {
          "enum": [
            "up",
            "down",
            "left",
            "right",
            "none"
          ],
          "description": "Hacia dónde apunta la cola (speech y thought)."
        },
        "tailAt": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Posición de la cola en % del lado."
        },
        "shape": {
          "enum": [
            "box"
          ],
          "description": "box hace el globo rectangular redondeado."
        },
        "dark": {
          "type": "boolean",
          "description": "Rótulo en negativo (label)."
        }
      }
    },
    "bubblePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/bubble/properties/text"
        },
        "x": {
          "$ref": "#/$defs/bubble/properties/x"
        },
        "y": {
          "$ref": "#/$defs/bubble/properties/y"
        },
        "w": {
          "$ref": "#/$defs/bubble/properties/w"
        },
        "size": {
          "$ref": "#/$defs/bubble/properties/size"
        },
        "rot": {
          "$ref": "#/$defs/bubble/properties/rot"
        },
        "tail": {
          "$ref": "#/$defs/bubble/properties/tail"
        },
        "tailAt": {
          "$ref": "#/$defs/bubble/properties/tailAt"
        }
      }
    }
  }
}
